<?xml version="1.0" encoding="UTF-8"?>
<!--
  Applied by `tauri build` to every executable it code-signs in the bundle
  (main binary and the notepad-audiotap sidecar in Contents/MacOS/), per
  bundle.macOS.entitlements in tauri.conf.json.

  com.apple.security.device.audio-input: hardened runtime gates any CoreAudio
  audio-input-capable device access behind this entitlement, even for a
  non-sandboxed app (com.apple.security.app-sandbox is not set here) — found
  2026-08-18 as a TCC log line ("kTCCServiceMicrophone ... requires
  entitlement com.apple.security.device.audio-input but it is missing")
  against the audiotap helper, which creates an aggregate device via
  AudioHardwareCreateAggregateDevice/AudioDeviceCreateIOProcIDWithBlock to
  read its system-audio process tap (native/macos/audiotap.swift) — the
  hardened-runtime check applies to that CoreAudio HAL input-device path
  regardless of it being a process tap, not a physical microphone. This is
  separate from the actual user-facing permission: the "System Audio
  Recording Only" TCC prompt (kTCCServiceAudioCapture) is already covered by
  NSAudioCaptureUsageDescription in Info.plist and unaffected by this key.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
